#!/usr/bin/env node
import { createConnection } from "node:net";
import { spawn, spawnSync } from "node:child_process";
import { closeSync, existsSync, mkdirSync, openSync, readFileSync, rmSync, writeFileSync } from "node:fs";
import path from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";

const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const artifacts = path.join(root, ".cursor/skills/verify-simple-annotator/artifacts");
const defaultState = path.join("/tmp", "simple-annotator-verify-state.json");
const pwBrowsers = process.env.VERIFY_PLAYWRIGHT_BROWSERS || "/tmp/simple-annotator-playwright";
const pwArgs = ["--no-sandbox", "--disable-dev-shm-usage"];
const verbs = new Set(["goto", "fill", "click", "hover", "wait", "select", "drag", "press", "screenshot", "snapshot", "me", "script"]);

function statePath() {
  return process.env.VERIFY_STATE || defaultState;
}

function storagePath() {
  return process.env.VERIFY_STORAGE || "/tmp/simple-annotator-verify-storage.json";
}

function nextVerifyDir(state) {
  return path.join(root, "frontend", state.distDir || ".next-verify");
}

function runTsconfig(state) {
  return `${nextVerifyDir(state)}.tsconfig.json`;
}

function defaultPath() {
  return existsSync(storagePath()) ? "/annotate" : "/";
}

function loadState() {
  if (!existsSync(statePath())) throw new Error(`no verify instance; run up first (${statePath()})`);
  return JSON.parse(readFileSync(statePath(), "utf8"));
}

function saveState(state) {
  writeFileSync(statePath(), JSON.stringify(state, null, 2));
}

function freePort(start) {
  return new Promise((resolve, reject) => {
    const tryPort = (port) => {
      if (port > start + 80) return reject(new Error("no free port"));
      const sock = createConnection({ host: "127.0.0.1", port });
      sock.once("connect", () => {
        sock.destroy();
        tryPort(port + 1);
      });
      sock.once("error", () => resolve(port));
    };
    tryPort(start);
  });
}

async function waitHttp(url, ms = 120000) {
  const start = Date.now();
  while (Date.now() - start < ms) {
    try {
      const res = await fetch(url, { redirect: "manual" });
      if (res.ok || res.status === 307) return;
    } catch {
      /* not up */
    }
    await new Promise((r) => setTimeout(r, 300));
  }
  throw new Error(`timeout waiting for ${url}`);
}

function tailLog(file) {
  if (!file || !existsSync(file)) return "";
  return readFileSync(file, "utf8").trim().split("\n").slice(-20).join("\n");
}

function alive(pid) {
  try {
    process.kill(pid, 0);
  } catch {
    return false;
  }
  // The pod's PID 1 does not reap orphans, so exited processes linger as zombies ("Z").
  try {
    return readFileSync(`/proc/${pid}/stat`, "utf8").split(") ").at(-1)[0] !== "Z";
  } catch {
    return true;
  }
}

function stopPid(pid) {
  if (!pid || !alive(pid)) return;
  try {
    process.kill(-pid, "SIGTERM");
  } catch {
    try {
      process.kill(pid, "SIGTERM");
    } catch {
      /* already gone */
    }
  }
}

function waitGone(pids, timeoutMs = 10_000) {
  const tick = new Int32Array(new SharedArrayBuffer(4));
  const deadline = Date.now() + timeoutMs;
  while (pids.some(alive) && Date.now() < deadline) Atomics.wait(tick, 0, 0, 100);
}

// Waits for exit so next dev's shutdown writes cannot recreate the build directory after `down`.
function stopVerifyTree(state) {
  const pids = [state.pid];
  const lock = path.join(nextVerifyDir(state), "dev", "lock");
  try {
    if (existsSync(lock)) pids.push(JSON.parse(readFileSync(lock, "utf8")).pid);
  } catch {
    /* ignore */
  }
  pids.forEach(stopPid);
  waitGone(pids.filter(Boolean));
}

async function cmdUp() {
  if (existsSync(statePath())) {
    const prev = JSON.parse(readFileSync(statePath(), "utf8"));
    if (prev.pid && alive(prev.pid)) {
      throw new Error(`verify instance already running pid=${prev.pid}; down it first`);
    }
  }
  const runId = process.env.VERIFY_RUN_ID || `${Date.now()}`;
  const distDir = `.next-verify/${runId.replace(/[^a-zA-Z0-9_-]/g, "_")}`;
  const webPort = await freePort(Number(process.env.VERIFY_WEB_PORT || 3100));
  const apiPort = await freePort(Number(process.env.VERIFY_API_PORT || 8100));
  if ([3000, 8000].includes(webPort) || [3000, 8000].includes(apiPort)) {
    throw new Error("refusing default dev ports 3000/8000");
  }
  const sqlite = process.env.SIMPLE_ANNOTATOR_SQLITE || `/tmp/simple-annotator-verify-${runId}.sqlite`;
  const log = `/tmp/simple-annotator-verify-${runId}.log`;
  const apiUrl = `http://127.0.0.1:${apiPort}`;
  const webUrl = `http://127.0.0.1:${webPort}`;
  const env = {
    ...process.env,
    API_PORT: String(apiPort),
    WEB_PORT: String(webPort),
    NEXT_PUBLIC_API_URL: apiUrl,
    NEXT_DIST_DIR: distDir,
    NEXT_TSCONFIG_PATH: `${distDir}.tsconfig.json`,
    SIMPLE_ANNOTATOR_SQLITE: sqlite,
    UV_CACHE_DIR: process.env.UV_CACHE_DIR || "/tmp/uv-cache",
  };
  env.GIRDER_TOKEN = "";
  if (process.env.VERIFY_GIRDER_API_URL) {
    const fixture = new URL(process.env.VERIFY_GIRDER_API_URL);
    if (fixture.hostname !== "127.0.0.1") throw new Error("fixture image source must be local");
    env.GIRDER_API_URL = fixture.href.replace(/\/$/, "");
    env.GIRDER_TOKEN = "verify-fixture";
  }
  mkdirSync(path.dirname(sqlite), { recursive: true });
  mkdirSync(artifacts, { recursive: true });
  // next dev adds `${distDir}/types` globs to its tsconfig. Give it a per-run file next to the
  // build directory (Turbopack cannot read inside it), so frontend/tsconfig.json stays untouched.
  mkdirSync(path.dirname(runTsconfig({ distDir })), { recursive: true });
  writeFileSync(runTsconfig({ distDir }), JSON.stringify({ extends: "../tsconfig.json" }));
  writeFileSync(log, "");
  const fd = openSync(log, "a");
  const child = spawn("npm", ["run", "dev"], {
    cwd: root,
    env,
    detached: true,
    stdio: ["ignore", fd, fd],
  });
  closeSync(fd);
  child.unref();
  const state = { runId, distDir, pid: child.pid, apiPort, webPort, sqlite, apiUrl, webUrl, log };
  saveState(state);
  try {
    await waitHttp(`${apiUrl}/health`);
    await waitHttp(webUrl);
  } catch (err) {
    stopVerifyTree(state);
    const extra = tailLog(log);
    throw extra ? new Error(`${err.message}\n${extra}`) : err;
  }
  console.log(JSON.stringify(state, null, 2));
}

async function ensureUp() {
  if (existsSync(statePath())) {
    const prev = JSON.parse(readFileSync(statePath(), "utf8"));
    if (prev.pid && alive(prev.pid)) {
      try {
        const [api, web] = await Promise.all([fetch(`${prev.apiUrl}/health`), fetch(prev.webUrl)]);
        if (api.ok && (web.ok || web.status < 500)) return prev;
      } catch {
        /* stale */
      }
      cmdDown();
    }
  }
  await cmdUp();
  return loadState();
}

function cmdDoctor() {
  return ensureUp().then((state) => {
    console.log(
      JSON.stringify(
        {
          ok: true,
          pid: state.pid,
          apiUrl: state.apiUrl,
          webUrl: state.webUrl,
          sqlite: state.sqlite,
          log: state.log,
        },
        null,
        2,
      ),
    );
  });
}

function cmdDown() {
  if (!existsSync(statePath())) {
    console.log("nothing to stop");
    return;
  }
  const state = JSON.parse(readFileSync(statePath(), "utf8"));
  stopVerifyTree(state);
  if (state.sqlite && existsSync(state.sqlite)) rmSync(state.sqlite, { force: true });
  const nextDir = nextVerifyDir(state);
  if (existsSync(nextDir)) rmSync(nextDir, { recursive: true, force: true });
  rmSync(runTsconfig(state), { force: true });
  rmSync(statePath(), { force: true });
  const storage = storagePath();
  if (existsSync(storage)) rmSync(storage, { force: true });
  console.log("stopped");
}

async function launchChromium() {
  process.env.PLAYWRIGHT_BROWSERS_PATH = pwBrowsers;
  const { chromium } = await import("playwright");
  const opts = { headless: true, args: pwArgs };
  try {
    return await chromium.launch(opts);
  } catch (err) {
    if (!String(err).includes("Executable doesn't exist")) throw err;
    mkdirSync(pwBrowsers, { recursive: true });
    const install = spawnSync("npx", ["playwright", "install", "chromium"], {
      cwd: root,
      env: process.env,
      stdio: "inherit",
    });
    if (install.status) throw err;
    return chromium.launch(opts);
  }
}

async function withPage(fn) {
  const state = await ensureUp();
  const storage = storagePath();
  const browser = await launchChromium();
  const context = await browser.newContext({
    baseURL: state.webUrl,
    storageState: existsSync(storage) ? storage : undefined,
  });
  const page = await context.newPage();
  try {
    const result = await fn(page, state);
    await context.storageState({ path: storage });
    return result;
  } finally {
    await browser.close();
  }
}

function parseSteps(args) {
  const steps = [];
  let cur = null;
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (verbs.has(a)) {
      cur = { action: a, flags: {} };
      steps.push(cur);
      continue;
    }
    if (a.startsWith("--") && cur) {
      const next = args[i + 1];
      if (next === undefined || next.startsWith("--") || verbs.has(next)) cur.flags[a.slice(2)] = "";
      else cur.flags[a.slice(2)] = args[++i];
    }
  }
  return steps;
}

function xy(value) {
  const [x, y] = String(value).split(",").map(Number);
  if (![x, y].every(Number.isFinite)) throw new Error(`bad point ${value}`);
  return { x, y };
}

function writeOut(file, body) {
  mkdirSync(path.dirname(file), { recursive: true });
  if (body !== undefined) writeFileSync(file, body);
  console.log(file);
  return file;
}

async function applyStep(page, state, step) {
  const f = step.flags;
  if (step.action === "script") {
    const check = await import(pathToFileURL(path.resolve(f.file)).href);
    return check.default(page, state);
  }
  if (step.action === "goto") return page.goto(f.path || defaultPath());
  if (step.action === "fill") return page.getByTestId(f.testid).fill(f.value);
  if (step.action === "click" || step.action === "hover") {
    const loc = page.getByTestId(f.testid);
    return loc[step.action](f.at ? { position: xy(f.at) } : {});
  }
  if (step.action === "wait") {
    if (f.cursor) {
      return page.waitForFunction(({ id, cursor }) => {
        const el = document.querySelector(`[data-testid="${id}"]`);
        return el && getComputedStyle(el).cursor === cursor;
      }, { id: f.testid, cursor: f.cursor });
    }
    if (f.image !== undefined) {
      return page.waitForFunction((id) => {
        const img = document.querySelector(`[data-testid="${id}"] [data-image-plane]`);
        return img?.dataset.loaded === 'true';
      }, f.testid);
    }
    let loc = page.getByTestId(f.testid);
    if (f.text) loc = loc.filter({ hasText: f.text });
    return loc.waitFor({ timeout: Number(f.timeout || 15000) });
  }
  if (step.action === "select") {
    await page.getByTestId(f.testid).click();
    const opt = page.getByTestId(f.option);
    await opt.waitFor();
    await opt.click();
    return opt.waitFor({ state: "hidden" });
  }
  if (step.action === "press") return page.keyboard.press(f.key);
  if (step.action === "drag") {
    const loc = page.getByTestId(f.testid);
    const box = await loc.boundingBox();
    if (!box) throw new Error(`no box for ${f.testid}`);
    if (f.shift !== undefined) await page.keyboard.down("Shift");
    const pts = [xy(f.from), ...(f.via ? [xy(f.via)] : []), xy(f.to)];
    await loc.hover({ position: pts[0] });
    await page.mouse.down();
    if (f.pause) await page.waitForTimeout(Math.min(2000, Number(f.pause)));
    for (const p of pts.slice(1)) await page.mouse.move(box.x + p.x, box.y + p.y, { steps: 8 });
    await page.mouse.up();
    if (f.shift !== undefined) await page.keyboard.up("Shift");
    return;
  }
  if (step.action === "screenshot") {
    const out = writeOut(f.out || path.join(artifacts, "screenshot.png"));
    return page.screenshot({ path: out, fullPage: true });
  }
  if (step.action === "snapshot") {
    return writeOut(f.out || path.join(artifacts, "aria.txt"), await page.locator("body").ariaSnapshot());
  }
  if (step.action === "me") {
    const me = await page.request.get(`${state.webUrl}/me`);
    if (!me.ok()) throw new Error("/me failed");
    return writeOut(f.out || path.join(artifacts, "me.json"), JSON.stringify(await me.json(), null, 2));
  }
  throw new Error(`unknown browser action ${step.action}`);
}

async function runSteps(page, state, args, land = false) {
  const steps = parseSteps(args);
  if (!steps.length) throw new Error("browser needs goto|fill|click|hover|wait|select|drag|press|screenshot|snapshot|me");
  if (land && steps[0].action !== "goto") await page.goto(defaultPath());
  for (const step of steps) await applyStep(page, state, step);
}

async function cmdBrowser(args) {
  await withPage((page, state) => runSteps(page, state, args, true));
}

async function cmdLoginProof() {
  const user = `v${Date.now()}`;
  const afterShot = path.join(artifacts, "login-after.png");
  const afterAria = path.join(artifacts, "login-after.aria.txt");
  const mePath = path.join(artifacts, "login-me.json");
  await withPage(async (page, state) => {
    await runSteps(page, state, [
      "goto", "--path", "/",
      "fill", "--testid", "username", "--value", user,
      "fill", "--testid", "password", "--value", "verify-pass",
      "screenshot", "--out", path.join(artifacts, "login-before.png"),
      "click", "--testid", "register-submit",
      "wait", "--testid", "annotate-app", "--timeout", "60000",
    ]);
    await page.getByTestId("patch-canvas").locator("[data-image-plane][data-loaded]").waitFor({ state: "attached", timeout: 15000 });
    await runSteps(page, state, [
      "screenshot", "--out", afterShot,
      "snapshot", "--out", afterAria,
      "me", "--out", mePath,
    ]);
    if (JSON.parse(readFileSync(mePath, "utf8")).username !== user) throw new Error("unexpected /me user");
    console.log(JSON.stringify({ ok: true, user, afterShot, afterAria }, null, 2));
  });
}

const [cmd, ...rest] = process.argv.slice(2);
const commands = {
  up: cmdUp,
  doctor: cmdDoctor,
  down: cmdDown,
  "login-proof": cmdLoginProof,
  browser: () => cmdBrowser(rest),
  url: () => console.log(loadState().webUrl),
  sqlite: () => console.log(loadState().sqlite),
};

if (!cmd || !commands[cmd]) {
  console.error("usage: verify-simple-annotator up|doctor|down|login-proof|browser|url|sqlite");
  process.exit(1);
}

Promise.resolve(commands[cmd]()).catch((err) => {
  console.error(err.message || err);
  process.exit(1);
});
