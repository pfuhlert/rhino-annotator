#!/usr/bin/env node
import { spawn, spawnSync } from "node:child_process";
import { copyFileSync, existsSync, mkdirSync, openSync, readdirSync, readFileSync, realpathSync, rmSync, writeFileSync } from "node:fs";
import { homedir } from "node:os";
import path from "node:path";
import { fileURLToPath } from "node:url";

const repo = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const home = process.env.SIMPLE_ANNOTATOR_PROD_DIR || path.join(homedir(), "simple-annotator-prod");
const app = path.join(home, "app");
const data = path.join(home, "data");
const logs = path.join(home, "logs");
const pids = path.join(home, "pids");
const lastDeploy = path.join(home, "last-deploy.json");
const venv = path.join(homedir(), ".uv-local/venvs/simple-annotator-prod");
const sqlite = path.join(data, "annotator.sqlite");
const webPort = "3300";
const apiPort = "8300";
const keepBackups = 5;

function loadDotenv(file) {
  const out = {};
  if (!existsSync(file)) return out;
  for (const line of readFileSync(file, "utf8").split("\n")) {
    const t = line.trim();
    const i = t.indexOf("=");
    if (!t || t.startsWith("#") || i < 1) continue;
    out[t.slice(0, i).trim()] = t.slice(i + 1).trim().replace(/^(["'])(.*)\1$/, "$2");
  }
  return out;
}

function env() {
  return {
    ...loadDotenv(path.join(home, ".env")),
    ...process.env,
    SIMPLE_ANNOTATOR_SQLITE: sqlite,
    NEXT_PUBLIC_API_URL: `http://127.0.0.1:${apiPort}`,
    UV_CACHE_DIR: process.env.UV_CACHE_DIR || "/tmp/uv-cache",
    VIRTUAL_ENV: venv,
    UV_PROJECT_ENVIRONMENT: venv,
  };
}

function run(cmd, args, cwd) {
  console.log(`$ ${cmd} ${args.join(" ")}`);
  const r = spawnSync(cmd, args, { cwd, env: env(), stdio: "inherit" });
  if (r.status !== 0) throw new Error(`${path.basename(cmd)} ${args[0]} failed`);
}

function git(cwd, ...args) {
  const r = spawnSync("git", args, { cwd, encoding: "utf8" });
  if (r.status !== 0) throw new Error(r.stderr.trim());
  return r.stdout.trim();
}

function short(sha) {
  return sha.slice(0, 7);
}

const services = {
  api: () => [path.join(venv, "bin/uvicorn"), ["simple_annotator.main:app", "--host", "127.0.0.1", "--port", apiPort], path.join(app, "backend")],
  worker: () => [path.join(venv, "bin/python"), ["-m", "simple_annotator.ai_worker"], path.join(app, "backend")],
  web: () => [path.join(app, "frontend/node_modules/.bin/next"), ["start", "--port", webPort, "--hostname", "127.0.0.1"], path.join(app, "frontend")],
};

function readPid(name) {
  const file = path.join(pids, `${name}.pid`);
  return existsSync(file) ? Number(readFileSync(file, "utf8")) : 0;
}

// Pid files outlive pod restarts, so only trust a pid that still runs inside the prod checkout.
// The pod's PID 1 does not reap orphans, so exited processes linger as zombies ("Z").
function alive(pid) {
  try {
    const root = realpathSync(app);
    const cwd = realpathSync(`/proc/${pid}/cwd`);
    const state = readFileSync(`/proc/${pid}/stat`, "utf8").split(") ").at(-1)[0];
    return cwd.startsWith(root + path.sep) && state !== "Z";
  } catch {
    return false;
  }
}

function signal(pid, sig) {
  try {
    process.kill(-pid, sig);
  } catch {
    /* already gone */
  }
}

function sleep(ms) {
  Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms);
}

function stop() {
  const running = Object.keys(services).map(readPid).filter(alive);
  for (const pid of running) signal(pid, "SIGTERM");
  const deadline = Date.now() + 15_000;
  while (running.some(alive) && Date.now() < deadline) sleep(200);
  for (const pid of running.filter(alive)) signal(pid, "SIGKILL");
  for (const name of Object.keys(services)) rmSync(path.join(pids, `${name}.pid`), { force: true });
}

async function start() {
  if (!existsSync(path.join(app, "frontend/.next/BUILD_ID"))) throw new Error("nothing deployed; run deploy first");
  stop();
  mkdirSync(logs, { recursive: true });
  mkdirSync(pids, { recursive: true });
  const names = Object.keys(services).filter((n) => n !== "worker" || env().SIMPLE_ANNOTATOR_AI !== "0");
  for (const name of names) {
    const [cmd, args, cwd] = services[name]();
    const log = openSync(path.join(logs, `${name}.log`), "a");
    const child = spawn(cmd, args, { cwd, env: env(), detached: true, stdio: ["ignore", log, log] });
    writeFileSync(path.join(pids, `${name}.pid`), String(child.pid));
    child.unref();
  }
  const url = `http://127.0.0.1:${webPort}/health`;
  const deadline = Date.now() + 120_000;
  while (Date.now() < deadline) {
    try {
      if ((await fetch(url)).ok) return console.log(`up: ${url.replace("/health", "")}`);
    } catch {
      /* not up yet */
    }
    await new Promise((r) => setTimeout(r, 500));
  }
  throw new Error(`timeout waiting for ${url}`);
}

// Processes are stopped and SQLite uses a rollback journal, so the file alone is consistent.
function backup() {
  if (!existsSync(sqlite)) return;
  const dir = path.join(data, "backups");
  mkdirSync(dir, { recursive: true });
  const out = path.join(dir, `annotator-${new Date().toISOString().replace(/[:.]/g, "-")}.sqlite`);
  copyFileSync(sqlite, out);
  for (const old of readdirSync(dir).sort().slice(0, -keepBackups)) rmSync(path.join(dir, old));
  console.log(`backup: ${out}`);
}

async function install(sha) {
  run("git", ["checkout", "--force", "--detach", sha], app);
  const ai = env().SIMPLE_ANNOTATOR_AI !== "0" ? ["--extra", "ai"] : [];
  run("uv", ["sync", "--locked", "--no-dev", ...ai], path.join(app, "backend"));
  run("npm", ["ci", "--no-audit", "--no-fund"], path.join(app, "frontend"));
  run(path.join(app, "frontend/node_modules/.bin/next"), ["build"], path.join(app, "frontend"));
  await start();
}

async function deploy(ref = "main") {
  const sha = git(repo, "rev-parse", "--verify", `${ref}^{commit}`);
  mkdirSync(data, { recursive: true });
  if (!existsSync(path.join(home, ".env")) && existsSync(path.join(repo, ".env"))) {
    copyFileSync(path.join(repo, ".env"), path.join(home, ".env"));
  }
  if (!existsSync(app)) {
    git(repo, "worktree", "prune");
    git(repo, "worktree", "add", "--detach", app, sha);
  }
  const previous = git(app, "rev-parse", "HEAD");
  const record = (error) =>
    writeFileSync(lastDeploy, JSON.stringify({ sha, ok: !error, at: new Date().toISOString(), error }));
  stop();
  backup();
  try {
    await install(sha);
  } catch (err) {
    let error = `deploy of ${short(sha)} failed (${err.message})`;
    if (previous !== sha) {
      console.error(`${error}; rolling back to ${short(previous)}`);
      await install(previous).then(
        () => (error += `; rolled back to ${short(previous)}`),
        (e) => (error += `; rollback to ${short(previous)} failed (${e.message}), prod is down`),
      );
    }
    record(error);
    throw new Error(`${error}; see ${home}/logs`);
  }
  record();
  console.log(`deployed ${git(repo, "log", "-1", "--format=%h %s", sha)}`);
}

function status() {
  console.log(`deployed: ${existsSync(app) ? git(app, "log", "-1", "--format=%h %cr %s") : "none"}`);
  if (existsSync(lastDeploy)) {
    const last = JSON.parse(readFileSync(lastDeploy, "utf8"));
    console.log(`last:     ${last.ok ? `ok ${short(last.sha)}` : `FAILED: ${last.error}`} at ${last.at}`);
  }
  console.log(`url:      http://127.0.0.1:${webPort}`);
  console.log(`db:       ${sqlite}`);
  for (const name of Object.keys(services)) {
    const pid = readPid(name);
    console.log(`${name.padEnd(9)} ${alive(pid) ? `running pid=${pid}` : "stopped"}`);
  }
}

function tail() {
  const files = Object.keys(services).map((n) => path.join(logs, `${n}.log`)).filter(existsSync);
  spawn("tail", ["-n", "50", "-F", ...files], { stdio: "inherit" });
}

const [cmd, arg] = process.argv.slice(2);
const commands = { deploy: () => deploy(arg), start, stop, restart: start, status, logs: tail };
if (!commands[cmd]) {
  console.error("usage: scripts/prod deploy [ref] | start | stop | restart | status | logs");
  process.exit(1);
}
// Deploys from the push hook and from the shell must not touch the checkout at the same time.
if (!["status", "logs"].includes(cmd) && !process.env.PROD_LOCKED) {
  mkdirSync(home, { recursive: true });
  const lock = path.join(home, "deploy.lock");
  const r = spawnSync("flock", [lock, process.execPath, ...process.argv.slice(1)], {
    stdio: "inherit",
    env: { ...process.env, PROD_LOCKED: "1" },
  });
  process.exit(r.status ?? 1);
}
try {
  await commands[cmd]();
} catch (err) {
  console.error(err.message);
  process.exit(1);
}
